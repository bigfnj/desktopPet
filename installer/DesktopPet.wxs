<?xml version="1.0" encoding="UTF-8"?>
<!--
  Per-user, x64 MSI for DesktopPet AI Edition.

  ProductName, Manufacturer, ProductVersion, RepositoryUrl, UpgradeCode, and
  RegistryRoot are supplied by build-installer.ps1. RuntimeComponents is generated
  from packaging/runtime-files.txt, so ZIP and MSI payloads cannot silently diverge.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="$(var.ProductName)"
           Manufacturer="$(var.Manufacturer)"
           Version="$(var.ProductVersion)"
           UpgradeCode="$(var.UpgradeCode)"
           Scope="perUser"
           InstallerVersion="500"
           Compressed="yes">

    <!-- afterInstallInitialize: remove the previous version's files BEFORE the new payload is laid down, so an
         upgrade never writes the new files over the old (possibly loaded) ones in place — the cause of the
         "Error writing to file ...Contracts.dll" (1304) modal when the old app was still running. Stays
         strictly inside InstallInitialize < RemoveExistingProducts < InstallFinalize (Test-MsiUpgradeSchedule). -->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed." />
    <!-- TODO(installer): also add util:CloseApplication (WixToolset.Util.wixext) to close a still-running
         instance before file costing, so an upgrade over the running app never even needs the Restart Manager
         prompt. Deferred because it requires adding a second hash-pinned extension to the locked WiX toolchain
         (packaging/wix-toolchain-lock.json + Install-LockedWixToolchain.ps1 + build-installer.ps1) and a local
         MSI build to verify — the Util.wixext 5.0.2 pins are: nupkg sha256
         dda1cc1b4d3b2305b1246f167c6af6fcded5000be84b3bbff3dda4f442bf4740; wixext5/WixToolset.Util.wixext.dll
         len 944912 sha256 c76cd00e8800cf785ff3cffd2ed3475915b487c7a3d441a266175cdc326912eb. -->
    <MediaTemplate EmbedCab="yes" />

    <!-- Product icon (installer + Programs & Features) = the sheep, not the app exe's red emblem. -->
    <Icon Id="SheepIcon.ico" SourceFile="sheep.ico" />
    <Property Id="ARPPRODUCTICON" Value="SheepIcon.ico" />
    <Property Id="ARPHELPLINK" Value="$(var.RepositoryUrl)" />
    <Property Id="ARPURLINFOABOUT" Value="$(var.RepositoryUrl)" />
    <!--
      The public test-only directory properties are unset in production, preserving
      the normal Desktop and Start Menu destinations. The isolated lifecycle harness
      supplies them on every maintenance operation so it cannot overwrite a user's
      existing shortcuts. Registry key paths are similarly redirected by overriding
      the production-default DESKTOPPET_REGISTRYROOT property.
    -->
    <Property Id="DESKTOPPET_REGISTRYROOT"
              Value="$(var.RegistryRoot)"
              Secure="yes" />
    <Property Id="DESKTOPPET_ISOLATED_LIFECYCLE_CAPABILITY" Value="1" />
    <Property Id="INSTALLFOLDER" Secure="yes" />
    <Property Id="DESKTOPPET_TEST_DESKTOPFOLDER" Secure="yes" />
    <Property Id="DESKTOPPET_TEST_STARTMENUFOLDER" Secure="yes" />
    <!--
      Per-user runtime components require HKCU registry key paths for ICE38, so
      Add/Remove Programs cannot reliably infer a missing payload file. Hide its
      misleading repair button; the verified maintenance path remains an explicit
      full-file repair from the original MSI.
    -->
    <Property Id="ARPNOREPAIR" Value="1" />
    <!--
      No runtime launch condition. This is a framework-dependent .NET 10 app: the MSI installs
      regardless, and the apphost (DesktopPet.exe) prompts to install the .NET Desktop runtime on
      first launch if it is missing. (Replaces the old .NET Framework 4.8 NDP registry gate.)
    -->
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]"
                 After="CostFinalize" Sequence="execute" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="$(var.ProductName)" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="$(var.ProductName)" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
    <SetDirectory Id="DesktopFolder"
                  Value="[DESKTOPPET_TEST_DESKTOPFOLDER]"
                  Condition="DESKTOPPET_TEST_DESKTOPFOLDER"
                  Sequence="both" />
    <SetDirectory Id="AppMenuFolder"
                  Value="[DESKTOPPET_TEST_STARTMENUFOLDER]"
                  Condition="DESKTOPPET_TEST_STARTMENUFOLDER"
                  Sequence="both" />

    <!--
      Per-user profile components use HKCU registry key paths (ICE38). RemoveFolder
      rows cover every application-created profile directory (ICE64) without
      deleting %LOCALAPPDATA%\Programs when another application still uses it.
    -->
    <Component Id="CmpInstallFolderState" Directory="INSTALLFOLDER"
               Guid="$(var.InstallFolderStateComponentGuid)">
      <!--
        The release upgrade gate seeds this historical tombstone after installing
        the hash-pinned N-1 MSI. Its removal proves that the current package's
        install transaction actively cleans an obsolete install-root file.
      -->
      <RemoveFile Id="RemoveObsoleteUpgradeProbe"
                  Name="DesktopPet.obsolete-upgrade-probe"
                  On="install" />
      <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      <RemoveFolder Id="RemoveProgramsFolderWhenEmpty" Directory="ProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="[DESKTOPPET_REGISTRYROOT]"
                     Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
    </Component>

    <Component Id="CmpStartMenuFolderState" Directory="AppMenuFolder"
               Guid="$(var.StartMenuFolderStateComponentGuid)">
      <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="[DESKTOPPET_REGISTRYROOT]"
                     Name="StartMenuFolder" Type="string" Value="[AppMenuFolder]" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="$(var.ProductName)" Level="1">
      <ComponentGroupRef Id="RuntimeComponents" />
      <ComponentRef Id="CmpInstallFolderState" />
      <ComponentRef Id="CmpStartMenuFolderState" />
    </Feature>

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
    <!-- Welcome/Finish sidebar art: the pet pasture (blue sky, clouds, green hill). 493x312 24-bit BMP. -->
    <WixVariable Id="WixUIDialogBmp" Value="dialog.bmp" />
  </Package>
</Wix>
