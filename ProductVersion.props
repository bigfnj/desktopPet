<Project>
  <!--
    Canonical product identity. Build, assembly metadata, MSI authoring, and release
    verification all consume these values; do not duplicate version strings elsewhere.
  -->
  <PropertyGroup>
    <DesktopPetProductName>DesktopPet AI Edition</DesktopPetProductName>
    <DesktopPetPublisher>bigfnj</DesktopPetPublisher>
    <DesktopPetDescription>A physics-driven desktop pet with offline smart fortunes and an optional AI brain</DesktopPetDescription>
    <!-- MUST be bumped in the same change as any plugin-ABI edit. DesktopPet.Contracts stamps its
         FileVersion from this value, and a Windows Installer major upgrade SKIPS refreshing a file whose
         version did not change: shipping an ABI change without this bump installs a stale Contracts.dll
         that cannot resolve the new types (the failure 9009133 fixed). -->
    <DesktopPetVersion>1.4.7</DesktopPetVersion>
    <DesktopPetAssemblyVersion>1.4.7.0</DesktopPetAssemblyVersion>
    <DesktopPetRepositoryUrl>https://github.com/bigfnj/desktopPet</DesktopPetRepositoryUrl>
    <DesktopPetCopyright>Copyright (c) 2015-2026 DesktopPet contributors</DesktopPetCopyright>
  </PropertyGroup>
</Project>
