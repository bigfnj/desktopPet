<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Sound module (S2): the first real capability extracted from the base into a plugin. Builds to
       the app's runtime modules\sound\ folder so the loader picks it up. References ONLY the plugin ABI
       (Private=false => the host's single shared DesktopPet.Contracts is used) and carries NAudio as its
       OWN dependency — NAudio.*.dll + Sound.deps.json land beside Sound.dll and resolve through the
       module's AssemblyLoadContext. The base app no longer references NAudio. Unlike the trivial
       TestModule this DOES emit a deps.json (GenerateDependencyFile) so the dependency resolver can find
       NAudio in the module folder. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DesktopPet.SoundModule</RootNamespace>
    <AssemblyName>Sound</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <!-- A library project does NOT copy its NuGet dependencies to output by default; the module must
         carry NAudio (NAudio.*.dll) beside Sound.dll so the module's AssemblyLoadContext can resolve it. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputPath>..\..\build\DesktopPetPortable\bin\$(Configuration)\x64\modules\sound\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DesktopPet.Contracts\DesktopPet.Contracts.csproj" Private="false" />
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship NAudio's license inside the module folder (it left the base root with NAudio). -->
    <Content Include="..\..\packaging\licenses\NAUDIO_LICENSE.txt"
             Condition="Exists('..\..\packaging\licenses\NAUDIO_LICENSE.txt')">
      <Link>NAUDIO_LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
