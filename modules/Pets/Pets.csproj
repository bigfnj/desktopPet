<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Pets module (S6 phase 2): the pet roster + online-download UI, moved out of the host into a
       plugin. Everything runs through IPetManager (host.GetPetManager()); this project references ONLY the
       plugin ABI (Private=false => the host's single shared DesktopPet.Contracts is used). It carries NO UI
       framework of its own — the pane and tray are declarative ABI data (OptionsPane + ListCard with the new
       per-row RowActions + TrayItem), the same "modules ship data + delegates, the host owns the WPF" contract
       Fortunes/AiBrain follow. Builds to the runtime modules\pets\ folder so the loader picks it up. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DesktopPet.PetsModule</RootNamespace>
    <AssemblyName>Pets</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputPath>..\..\build\DesktopPetPortable\bin\$(Configuration)\x64\modules\pets\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DesktopPet.Contracts\DesktopPet.Contracts.csproj" Private="false" />
  </ItemGroup>

</Project>
