<Project Sdk="Microsoft.NET.Sdk">

  <!-- A DesktopPet plugin module (see templates\desktoppet-module). The load-bearing bits: OutputPath must
       end in modules\<id>\ because the host scans <app>\modules and loads <id>\<id>.dll; Contracts is
       Private="false" so the module binds the HOST's single shared copy (ship a second and the IModule cast
       fails at load); AppendTargetFrameworkToOutputPath=false keeps the dll where the loader looks. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DesktopPet.BlinkingLed</RootNamespace>
    <AssemblyName>BlinkingLed</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\build\DesktopPetPortable\bin\$(Configuration)\x64\modules\blinkingled\</OutputPath>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- WinForms for the blink timer and Control.IsKeyLocked (the Caps/Scroll Lock read). No window: the
         host renders the tray item and the options pane from the data this module declares. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DesktopPet.Contracts\DesktopPet.Contracts.csproj" Private="false" />
    <ProjectReference Include="..\..\src\DesktopPet.ModuleKit\DesktopPet.ModuleKit.csproj" />
  </ItemGroup>

</Project>
