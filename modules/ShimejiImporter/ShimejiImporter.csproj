<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shimeji Catalog: a curated, browsable list of ready-to-install shimeji pets. Import-your-own moved into
       Pet Studio; this module is the STORE. It ships PRE-CONVERTED pet animations.xml (converted at curation
       time from sources we have permission to redistribute) plus a manifest, so it carries NO converter at
       all: just Contracts + a WPF window that decodes each pet's icon for a thumbnail and installs it through
       IPetManager.InstallType. Contained like every module: Contracts is Private=false (the host's single
       shared copy). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DesktopPet.ShimejiImporterModule</RootNamespace>
    <AssemblyName>ShimejiImporter</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputPath>..\..\build\DesktopPetPortable\bin\$(Configuration)\x64\modules\shimejiimporter\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DesktopPet.Contracts\DesktopPet.Contracts.csproj" Private="false" />
  </ItemGroup>

  <!-- The curated catalog: a manifest + the pre-converted pet XMLs, embedded so the module is self-contained.
       Logical names are catalog/<file> so the module reads them by a stable path. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\catalog\*">
      <LogicalName>catalog/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
