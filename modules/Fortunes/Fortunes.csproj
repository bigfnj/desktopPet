<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Fortunes module (S3). Builds to the runtime modules\fortunes\ folder. Ships the fortune ENGINE
       + the personalized welcome starter, with ZERO bundled fortune content (see BACKLOG.md).
       S3c-1 relocates the DUMB engine here (engine\FortuneProvider.cs + FortuneFileImporter.cs, rebound to
       FortuneSettings / FortunePaths + a copied AtomicFile). It stays DORMANT (FortunesModule.Init still
       only does the welcome) so the base keeps owning fortunes until the flip (S3d) => no regression. The
       SMART layer (SmartFortunes + Embedder) + the ONNX PackageReference + bge-small model come in S3c-2.
       References ONLY the plugin ABI (Private=false => the host's shared contract). SDK default globbing
       compiles engine\*.cs. -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DesktopPet.FortunesModule</RootNamespace>
    <AssemblyName>Fortunes</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <OutputPath>..\..\build\DesktopPetPortable\bin\$(Configuration)\x64\modules\fortunes\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DesktopPet.Contracts\DesktopPet.Contracts.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The personalized starter corpus: sheep-themed one-liners with a {name} slot, filled with the
         Windows username. This is the module's default voice until the user adds real fortune packs.
         Not "content" in the pack sense - it's the greeting framework (adapted from ai-platform's
         DeskPet welcome quips). -->
    <EmbeddedResource Include="welcome.json" />
    <!-- Classifier-parity fixture the engine's FilterSelfTest reads (same LogicalName it looked up in the
         base). Not shipped content - a test fixture that keeps the relocated classifier check verifiable. -->
    <EmbeddedResource Include="..\..\src\Fortunes\classifier-parity-cases.tsv">
      <Link>classifier-parity-cases.tsv</Link>
      <LogicalName>DesktopPet.ClassifierParity.tsv</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
