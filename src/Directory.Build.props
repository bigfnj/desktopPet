<Project>
  <Import Project="$(MSBuildThisFileDirectory)..\ProductVersion.props"
          Condition="Exists('$(MSBuildThisFileDirectory)..\ProductVersion.props')" />
  <!--
    Shared MSBuild properties for every project under src/.

    THE product is the portable app: DesktopPet_Portable.csproj -> DesktopPet.exe
    (built via ..\build.ps1, opened via DesktopPet_Portable.sln). All the AI-Edition
    work lives there. Dead/legacy build flavors (classic eSheep.exe, UWP Store) are
    quarantined under src/legacy/ and are not expected to build in this environment.

    The C# source targets language level 7.3 (old-style csproj default). Pin it here
    so the level is explicit and consistent instead of relying on the toolchain default.
  -->
  <PropertyGroup>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <WarningLevel>4</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
