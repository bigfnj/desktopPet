<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET 10 (LTS) WinForms, framework-dependent, x64-only (ONNX native runtime is arch-specific and
       build.ps1 always builds x64). Converted from the classic net48 project; product identity/version
       still come from ProductVersion.props via the WriteCodeFragment targets below (GenerateAssemblyInfo
       stays off so there is one source of truth). Compile/EmbeddedResource/None/Content are listed
       explicitly (EnableDefaultItems=false) so src\legacy and Tools are never pulled in by globbing. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF is enabled alongside WinForms (both in-box on net10-windows) for the S5 module-manager /
         options window; the pet itself stays WinForms. The WPF window is shown from the WinForms UI thread. -->
    <UseWPF>true</UseWPF>
    <RootNamespace>DesktopPet</RootNamespace>
    <AssemblyName>DesktopPet</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- x64-only, framework-dependent. Pinning the RID (SelfContained=false keeps it FDD, no bundled
         runtime) flattens package native assets — WebView2Loader.dll, onnxruntime.dll — into the
         output root instead of a runtimes\win-x64\native subfolder, which the flat leaf-name payload
         manifest (runtime-files.txt) + ZIP + WiX generator require. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <SignAssembly>false</SignAssembly>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(RestoreLockedMode)' == '' and '$(CI)' == 'true'">true</RestoreLockedMode>
    <!-- Keep the flat bin\<Config>\x64 layout build.ps1 + packaging expect (no TFM/RID subfolder). -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- WFDEV006: the dev-only debug right-click menu still uses the legacy ContextMenu/MenuItem
         (kept for behavior parity during the migration; modernize to ContextMenuStrip later). -->
    <NoWarn>$(NoWarn);WFDEV006</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <OutputPath>..\build\DesktopPetPortable\bin\Debug\x64\</OutputPath>
    <IntermediateOutputPath>..\build\DesktopPet\obj\Debug\x64\</IntermediateOutputPath>
    <DefineConstants>TRACE;DEBUG;PORTABLE</DefineConstants>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>..\build\DesktopPetPortable\bin\Release\x64\</OutputPath>
    <IntermediateOutputPath>..\build\DesktopPet\obj\Release\x64\</IntermediateOutputPath>
    <DefineConstants>TRACE;PORTABLE</DefineConstants>
    <Optimize>true</Optimize>
    <!-- Release symbols are not distributed; no PDB keeps the runtime location-independent. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- Runtime NuGet dependencies. The net48 in-box shims (System.Buffers/Memory/ValueTuple/
       Threading.Tasks.Extensions/Numerics.Vectors/Runtime.CompilerServices.Unsafe/Security.*/
       Win32.Registry/Bcl.AsyncInterfaces/IO.Pipelines/Text.Json/Text.Encodings.Web) and the net48
       compiler + reference-assembly packages are dropped: they are provided by the .NET 10 shared
       framework / Windows Desktop framework. System.Drawing.Common, System.Configuration.Configuration-
       Manager, and System.Security.Cryptography.ProtectedData (DPAPI) are all provided by the
       net10-windows Windows Desktop framework too (the SDK prunes them; NU1510 confirms). Only these
       genuinely-external packages remain. -->
  <!-- DesktopPet.exe apphost + DesktopPet.dll are framework-dependent (require the .NET 10 Desktop runtime). -->
  <ItemGroup>
    <!-- ONNX moved to the Fortunes module (S3d): the smart fortune engine (Embedder/SmartFortunes) +
         onnxruntime + the bge-small model now live in modules/Fortunes. The base no longer references ONNX. -->

    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" GeneratePathProperty="true" />
    <!-- NAudio is a base dependency again as of B1 (host-owned audio output, AudioOutput.cs). It left in S2
         on the premise that no pet shipped audio; every bundled pet does. Only the two sub-packages we use:
         NAudio.Core (Mp3FileReaderBase + the mixer) + NAudio.WinMM (ACM MP3 decode via the OS codec, plus
         WaveOutEvent) — no NAudio.Dmo/Asio/Midi/WinForms, and no shipped native binary. NAudio 3 preview
         (net9+, Span-based) since the base is net10; verified decoding a real pet MP3 on net10. -->
    <PackageReference Include="NAudio.Core" Version="3.0.0-preview.6" />
    <PackageReference Include="NAudio.WinMM" Version="3.0.0-preview.6" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- The plugin ABI. Ships beside the exe so module DLLs bind to the same DesktopPet.Contracts. -->
    <ProjectReference Include="DesktopPet.Contracts\DesktopPet.Contracts.csproj" />
  </ItemGroup>

