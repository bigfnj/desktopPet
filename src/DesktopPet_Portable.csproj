  <ItemGroup>
    <Content Include="esheep.png.ico" />
    <Content Include="icon.ico" />
    <Content Include="Images\exit.png" />
    <Content Include="Images\help.png" />
    <Content Include="Images\about.png" />
    <Content Include="Images\esheep.png" />
    <!-- The bge-small smart-fortunes model moved to the Fortunes module (S3d), beside Fortunes.dll. -->
    <Content Include="..\LICENSE">
      <Link>LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\THIRD_PARTY_NOTICES.md">
      <Link>THIRD_PARTY_NOTICES.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\PRIVACY.md">
      <Link>PRIVACY.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\SUPPORT.md">
      <Link>SUPPORT.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\PROVENANCE.md">
      <Link>PROVENANCE.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- NAudio is a base dependency again as of B1 (host-owned audio); ship its license in the base root.
         The Sound module still carries its own copy until B4 retires it. -->
    <Content Include="..\packaging\licenses\NAUDIO_LICENSE.txt"
             Condition="Exists('..\packaging\licenses\NAUDIO_LICENSE.txt')">
      <Link>NAUDIO_LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- ONNX runtime licenses now ship with the Fortunes module (they moved with the engine, S3d). -->
    <Content Include="$(PkgNewtonsoft_Json)\LICENSE.md"
             Condition="'$(PkgNewtonsoft_Json)' != '' and Exists('$(PkgNewtonsoft_Json)\LICENSE.md')">
      <Link>NEWTONSOFT_JSON_LICENSE.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(PkgMicrosoft_Web_WebView2)\LICENSE.txt"
             Condition="'$(PkgMicrosoft_Web_WebView2)' != '' and Exists('$(PkgMicrosoft_Web_WebView2)\LICENSE.txt')">
      <Link>WEBVIEW2_LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(PkgMicrosoft_Web_WebView2)\NOTICE.txt"
             Condition="'$(PkgMicrosoft_Web_WebView2)' != '' and Exists('$(PkgMicrosoft_Web_WebView2)\NOTICE.txt')">
      <Link>WEBVIEW2_THIRD_PARTY_NOTICES.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="ValidateDesktopPetProductIdentity" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(DesktopPetProductName)' == '' or '$(DesktopPetPublisher)' == '' or '$(DesktopPetVersion)' == '' or '$(DesktopPetAssemblyVersion)' == ''"
           Text="ProductVersion.props is missing or incomplete. Product identity and version metadata cannot be generated." />
  </Target>
  <Target Name="GenerateDesktopPetProductInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_DesktopPetProductInfoFile>$(IntermediateOutputPath)DesktopPet.ProductInfo.g.cs</_DesktopPetProductInfoFile>
    </PropertyGroup>
    <ItemGroup>
      <_DesktopPetAssemblyAttribute Include="System.Reflection.AssemblyTitleAttribute">
        <_Parameter1>$(DesktopPetProductName)</_Parameter1>
      </_DesktopPetAssemblyAttribute>
      <_DesktopPetAssemblyAttribute Include="System.Reflection.AssemblyDescriptionAttribute">
        <_Parameter1>$(DesktopPetDescription)</_Parameter1>
      </_DesktopPetAssemblyAttribute>
      <_DesktopPetAssemblyAttribute Include="System.Reflection.AssemblyCompanyAttribute">
        <_Parameter1>$(DesktopPetPublisher)</_Parameter1>
      </_DesktopPetAssemblyAttribute>
      <_DesktopPetAssemblyAttribute Include="System.Reflection.AssemblyProductAttribute">
        <_Parameter1>$(DesktopPetProductName)</_Parameter1>
      </_DesktopPetAssemblyAttribute>
      <_DesktopPetAssemblyAttribute Include="System.Reflection.AssemblyCopyrightAttribute">
        <_Parameter1>$(DesktopPetCopyright)</_Parameter1>
      </_DesktopPetAssemblyAttribute>
      <_DesktopPetAssemblyAttribute Include="System.Reflection.AssemblyVersionAttribute">
        <_Parameter1>$(DesktopPetAssemblyVersion)</_Parameter1>
      </_DesktopPetAssemblyAttribute>
      <_DesktopPetAssemblyAttribute Include="System.Reflection.AssemblyFileVersionAttribute">
        <_Parameter1>$(DesktopPetAssemblyVersion)</_Parameter1>
      </_DesktopPetAssemblyAttribute>
      <_DesktopPetAssemblyAttribute Include="System.Reflection.AssemblyInformationalVersionAttribute">
        <_Parameter1>$(DesktopPetVersion)</_Parameter1>
      </_DesktopPetAssemblyAttribute>
    </ItemGroup>
    <WriteCodeFragment Language="C#"
                       OutputFile="$(_DesktopPetProductInfoFile)"
                       AssemblyAttributes="@(_DesktopPetAssemblyAttribute)" />
    <ItemGroup>
      <Compile Include="$(_DesktopPetProductInfoFile)" />
    </ItemGroup>
  </Target>

</Project>
