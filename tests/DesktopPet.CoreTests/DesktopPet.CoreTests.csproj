<Project Sdk="Microsoft.NET.Sdk">

  <!-- Custom console harness (its own Program.cs) that recompiles three production source files and
       asserts their invariants. net10.0-windows + UseWindowsForms so the shared sources compile in the
       same environment as the app (System.Drawing for RuntimeGeometry, MutexAcl/AccessControl for
       AppSettingsStore). Console (OutputType Exe) so CI can read its exit code + output at
       bin\Release\DesktopPet.CoreTests.exe. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\ProductVersion.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DesktopPet</RootNamespace>
    <AssemblyName>DesktopPet.CoreTests</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <WarningLevel>4</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(RestoreLockedMode)' == '' and '$(CI)' == 'true'">true</RestoreLockedMode>
    <!-- Keep the flat bin\<Config> layout the CI step + build docs expect (no TFM subfolder). -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <OutputPath>bin\Debug\</OutputPath>
    <IntermediateOutputPath>obj\Debug\</IntermediateOutputPath>
    <DefineConstants>TRACE;DEBUG</DefineConstants>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\Release\</OutputPath>
    <IntermediateOutputPath>obj\Release\</IntermediateOutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\Portable\AppPaths.cs">
      <Link>Production\AppPaths.cs</Link>
    </Compile>
    <Compile Include="..\..\src\Portable\AppSettingsStore.cs">
      <Link>Production\AppSettingsStore.cs</Link>
    </Compile>
    <Compile Include="..\..\src\dotNet\RuntimeGeometry.cs">
      <Link>Production\RuntimeGeometry.cs</Link>
    </Compile>
  </ItemGroup>

  <Target Name="GenerateDesktopPetCoreTestProductInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_DesktopPetCoreTestProductInfoFile>$(IntermediateOutputPath)DesktopPet.CoreTests.ProductInfo.g.cs</_DesktopPetCoreTestProductInfoFile>
    </PropertyGroup>
    <ItemGroup>
      <_DesktopPetCoreTestAssemblyAttribute Include="System.Reflection.AssemblyProductAttribute">
        <_Parameter1>$(DesktopPetProductName)</_Parameter1>
      </_DesktopPetCoreTestAssemblyAttribute>
      <!-- The shared production sources call Windows-only APIs (MutexAcl / WindowsIdentity); mark this
           harness Windows-only so CA1416 is satisfied (GenerateAssemblyInfo=false suppresses the SDK's
           auto platform attribute, same as the app project). -->
      <_DesktopPetCoreTestAssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
        <_Parameter1>windows7.0</_Parameter1>
      </_DesktopPetCoreTestAssemblyAttribute>
    </ItemGroup>
    <WriteCodeFragment Language="C#"
                       OutputFile="$(_DesktopPetCoreTestProductInfoFile)"
                       AssemblyAttributes="@(_DesktopPetCoreTestAssemblyAttribute)" />
    <ItemGroup>
      <Compile Include="$(_DesktopPetCoreTestProductInfoFile)" />
    </ItemGroup>
  </Target>

</Project>
